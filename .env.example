# Obrigatório — sem mock. Preencha todos os valores reais.

# Postgres (Railway: use a variável DATABASE_URL do plugin PostgreSQL)
# Ex.: postgresql://user:pass@host:5432/railway
# Produção: ajuste o pool com connection_limit e pool_timeout para não esgotar
# conexões do Postgres (ex.: ...?connection_limit=10&pool_timeout=20).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/railway"

AUTH_SECRET="cole-um-segredo-longo-e-aleatorio"

# Token exigido em /setup para criar o primeiro escritório — sem isso,
# qualquer visitante que chegue antes de você vira o dono do sistema.
# Gere um valor aleatório forte e informe-o apenas para quem for configurar.
BOOTSTRAP_TOKEN="cole-um-token-aleatorio-so-para-o-setup"

# E-mail real (SMTP)
SMTP_HOST="smtp.seuprovedor.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="guias@seuescritorio.com.br"

# NFS-e Sistema Nacional (ADN) — captura live
NFSE_ADN_BASE_URL="https://sefin.nfse.gov.br/sefinnacional"

# Cadeia raiz ICP-Brasil (AC-Raiz + intermediárias), em PEM, para validar o
# certificado do servidor da SEFAZ/ADN durante o mTLS. Se vazio, usa o bundle
# embarcado no repo (certs/icp-brasil-ca-bundle.pem, gerado do ACcompactado.zip
# oficial do ITI via scripts/build-icp-bundle.mjs). NÃO contorne desativando
# a verificação do peer.
SEFAZ_CA_BUNDLE_PATH=""

# UF do autor nas consultas CT-e DistDFe. O schema do CT-e só aceita códigos
# de UF reais (11-53) — 91 (Ambiente Nacional) é rejeitado com "Falha no
# esquema xml". Use a UF do escritório (35=SP, 33=RJ, 31=MG, 41=PR, ...).
CTE_CUF_AUTOR="35"

# Inbox IA (também pode salvar a chave em Integrações → OpenAI)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1"

# ProContador SaaS — API real (Railway). Não use api.procontador.com.br (DNS inexistente).
# Alternativa via proxy Vercel: https://www.procontador.com.br/api/v1
PROCONTADOR_API_URL="https://contador-api-production.up.railway.app/api/v1"

# Nunca ligue em produção
ALLOW_DEMO="false"

# Domínio canônico do escritório (após DNS office.procontador.com.br no Railway)
# Com isso, contabil.trustcorp.com.br redireciona 301 para cá.
CANONICAL_HOST="office.procontador.com.br"
