# Obrigatório — sem mock. Preencha todos os valores reais.

# Postgres — Supabase (Project Settings → Database → Connection string).
#
# Use SEMPRE o host do pooler (Supavisor). O host direto
# db.<ref>.supabase.co só resolve em IPv6 e falha no Railway, que hoje roda
# com ipv6EgressEnabled=false.
#
#   porta 5432 (session mode)     → é o que usamos. Compatível com o Prisma,
#                                   inclusive `prisma db push`. NÃO acrescente
#                                   ?pgbouncer=true aqui.
#   porta 6543 (transaction mode) → só para runtime serverless (Vercel/Lambda);
#                                   exige ?pgbouncer=true&connection_limit=1 e
#                                   um DIRECT_URL na 5432 para as migrations.
#
# Ex.: postgresql://postgres.<ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Produção: ajuste o pool com connection_limit e pool_timeout para não esgotar
# conexões do Postgres (ex.: ...?connection_limit=10&pool_timeout=20).
DATABASE_URL="postgresql://postgres.YOURREF:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

AUTH_SECRET="cole-um-segredo-longo-e-aleatorio"

# Cifra o material sensível em repouso (PFX/PEM dos certificados A1, credenciais
# de integração), em AES-256-GCM. Mínimo de 32 caracteres.
#
# ATENÇÃO ao nome: o código lê CERT_ENCRYPTION_KEY, não ENCRYPTION_KEY. Se a
# variável estiver ausente, o payload cai no esquema legado v1 derivado do
# AUTH_SECRET — silenciosamente, e com chave diferente da de produção.
# Deve ser DIFERENTE do AUTH_SECRET. Ao trocá-la, rode `npm run certs:rekey`
# ANTES, senão o material já cifrado fica ilegível.
CERT_ENCRYPTION_KEY="cole-outro-segredo-longo-e-aleatorio"

# Token exigido em /setup para criar o primeiro escritório — sem isso,
# qualquer visitante que chegue antes de você vira o dono do sistema.
# Gere um valor aleatório forte e informe-o apenas para quem for configurar.
BOOTSTRAP_TOKEN="cole-um-token-aleatorio-so-para-o-setup"

# E-mail real (SMTP)
SMTP_HOST="smtp.seuprovedor.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="guias@seuescritorio.com.br"

# NFS-e Sistema Nacional (ADN) — captura live via GET /DFe/{NSU}.
# Os hosts oficiais já vêm com default correto no código (produção:
# https://adn.nfse.gov.br/contribuintes; produção restrita/homologação:
# https://adn.producaorestrita.nfse.gov.br/contribuintes) — NÃO defina estas
# variáveis a menos que precise sobrescrever. ATENÇÃO: o host do SEFIN
# Nacional (sefin.nfse.gov.br) é outro serviço (emissão/consulta por chave)
# e NÃO atende /DFe/{NSU} — usá-lo aqui causa "ADN HTTP 404".
NFSE_ADN_BASE_URL=""
NFSE_ADN_BASE_URL_HOM=""

# Cadeia raiz ICP-Brasil (AC-Raiz + intermediárias), em PEM, para validar o
# certificado do servidor da SEFAZ/ADN durante o mTLS. Se vazio, usa o bundle
# embarcado no repo (certs/icp-brasil-ca-bundle.pem, gerado do ACcompactado.zip
# oficial do ITI via scripts/build-icp-bundle.mjs). NÃO contorne desativando
# a verificação do peer.
SEFAZ_CA_BUNDLE_PATH=""

# UF do autor (cUFAutor) nas consultas DistDFe de NF-e e CT-e. Em ambos os
# schemas esse campo só aceita códigos de UF REAIS (11-53) — 91 (Ambiente
# Nacional) é rejeitado com "215-Rejeição: Falha no esquema xml" nos dois
# serviços. Use a UF do escritório (35=SP, 33=RJ, 31=MG, 41=PR, ...).
SEFAZ_CUF_AUTOR="35"
# Nome antigo, mantido só por compatibilidade (use SEFAZ_CUF_AUTOR acima):
CTE_CUF_AUTOR=""

# Inbox IA (também pode salvar a chave em Integrações → OpenAI)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1"

# ProContador SaaS — API real (Railway). Não use api.procontador.com.br (DNS inexistente).
# Alternativa via proxy Vercel: https://www.procontador.com.br/api/v1
PROCONTADOR_API_URL="https://contador-api-production.up.railway.app/api/v1"

# Nunca ligue em produção
ALLOW_DEMO="false"

# Domínio canônico do escritório (após DNS office.procontador.com.br no Railway)
# Com isso, contabil.trustcorp.com.br redireciona 301 para cá.
CANONICAL_HOST="office.procontador.com.br"
