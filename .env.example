# Obrigatório — sem mock. Preencha todos os valores reais.

# Postgres — Supabase PRO (Project Settings → Database → Connection string).
# Use a connection string "pooler" (porta 6543, ?pgbouncer=true) para serverless
# ou a direta (porta 5432) para migrations.
# Ex.: postgresql://postgres:PASSWORD@db.<ref>.supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:PASSWORD@db.YOURREF.supabase.co:5432/postgres"

# Assinatura da sessão (JWT). Segredo forte e aleatório.
AUTH_SECRET="cole-um-segredo-longo-e-aleatorio"

# Criptografia de dados sensíveis em repouso (PFX/PEM, credenciais de integração).
# DEVE ser diferente do AUTH_SECRET. Se ausente, cai para AUTH_SECRET (compat).
ENCRYPTION_KEY="cole-outro-segredo-longo-e-aleatorio"

# Supabase Storage (PRO) — arquivos persistentes (comprovantes, guias, XMLs).
# Service role key: Project Settings → API → service_role (NUNCA exponha no client).
# Crie um bucket PRIVADO com este nome no painel Storage.
SUPABASE_URL="https://YOURREF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="hub-files"

# E-mail real (SMTP)
SMTP_HOST="smtp.seuprovedor.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="guias@seuescritorio.com.br"

# NFS-e Sistema Nacional (ADN) — captura live
NFSE_ADN_BASE_URL="https://sefin.nfse.gov.br/sefinnacional"

# Inbox IA (também pode salvar a chave em Integrações → OpenAI)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# ProContador SaaS — API real via domínio público.
PROCONTADOR_API_URL="https://www.procontador.com.br/api/v1"

# Nunca ligue em produção
ALLOW_DEMO="false"

# Domínio canônico do escritório
# Com isso, contabil.trustcorp.com.br redireciona 301 para cá.
CANONICAL_HOST="office.procontador.com.br"
